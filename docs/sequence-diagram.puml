@startuml
' SPDX-License-Identifier: MIT
' Minesweeper Bot - Global Sequence Diagram

skinparam participantPadding 20
skinparam boxPadding 10

actor User
participant MinesweeperBot as Bot
participant Vision
participant Solver
participant Controller
participant "Win32 API" as Win32
participant pyautogui
participant "Minesweeper Game" as Game

== IDLE: Wait for Game Window ==
loop every 1 sec
  Bot -> Vision: get_screenshot()
  Vision -> Win32: find_window_by_title()
  Vision -> pyautogui: screenshot(region/clip)
  Vision --> Bot: screen (cv::Mat)
  Bot -> Vision: find_image(screen, board_tl.png)
  alt anchor found
    Vision --> Bot: (ax, ay, aw, ah)
    Bot -> Bot: state = "MAIN_MENU"
  else not found
    Vision --> Bot: None
  end
end

== MAIN_MENU: Start New Game ==
Bot -> Bot: _focus_game_window()
Bot -> Win32: find_window_by_title()
Win32 --> Bot: hwnd
Bot -> Win32: SetForegroundWindow(hwnd)
Bot -> pyautogui: press('f2')
Bot -> Bot: state = "TEST_CALIBRATION"

== TEST_CALIBRATION: Corner Calibration ==
Bot -> Vision: calibrate_grid()
  Vision -> Vision: get_screenshot() (window client area)
  Vision -> Vision: find_image(screen, board_tl.png)
  Vision -> Vision: matchTemplate(closed_tile) full region
  Vision -> Vision: filter my >= anchor_bottom (remove toolbar)
  Vision -> Vision: sort by (y, x) -> pick top-leftmost
  Vision -> Vision: _screen_to_client(tile_center) -> origin_x/y
  Vision --> Bot: {origin_x, origin_y, cell_w, cell_h}

group 4-corner click + verify [ _verify_calibration() ]
  Bot -> Bot: Controller = (origin_x, origin_y, cell_w, cell_h)
  loop 4 corners: (0,0), (0,29), (15,0), (15,29)
    Bot -> Bot: _focus_game_window()
    Bot -> Controller: click_cell(r, c)
      Controller -> pyautogui: moveTo(target_x, target_y)
      Controller -> pyautogui: click(button='left')
    note over Game: cell clicked open
  end

  Bot -> pyautogui: screenshot() (full screen)
  note over Bot: draw corner circles -> calibration_test_final.png

  Bot -> Vision: analyze_board(board_info)
    Vision -> Vision: get_screenshot()
    loop 16 rows * 30 cols
      Vision -> Vision: crop cell -> matchTemplate(flag/mine/numbers)
      alt match > 0.85
        Vision -> Vision: record val
      else
        Vision -> Vision: matchTemplate(closed_tile) > 0.9 -> -1
        Vision -> Vision: else -> -2 (blank)
      end
    end
    Vision --> Bot: matrix (16x30)

  alt all 4 corners opened (val != -1)
    Bot -> Bot: state = "FIRST_MOVE"
  else some corners still closed
    Bot -> Bot: state = "IDLE" (calibration failed)
  end
end

== FIRST_MOVE: First Click ==
Bot -> Vision: calibrate_grid()
Vision --> Bot: {origin_x, origin_y, cell_w, cell_h}
Bot -> Bot: Controller = (...)
Bot -> Bot: Solver = (rows=16, cols=30)
Bot -> Bot: _focus_game_window()
Bot -> Controller: click_cell(7, 14) (board center)
Bot -> Bot: state = "PLAYING"

== PLAYING: Main Game Loop ==
loop every 1 sec
  Bot -> Bot: _handle_dialogs()
    Bot -> Win32: GetForegroundWindow()
    Bot -> Win32: GetWindowTextW()
    alt title contains "game over" / "Game Over"
      Bot -> Win32: SetForegroundWindow(hwnd)
      Bot -> pyautogui: hotkey('alt', 'p')
      Bot -> Bot: state = "FIRST_MOVE"
      note over Bot: dialog handled, skip this cycle
    else title contains "new game" / "新游戏"
      Bot -> pyautogui: hotkey('alt', 'k')
      note over Bot: dismiss dialog, continue
    else title contains "Minesweeper" / "扫雷"
      note over Bot: normal game window, continue
    end
  alt dialog was handled
    Bot -> Bot: skip rest of loop
  end

  Bot -> Vision: analyze_board(board_info)
  Vision --> Bot: matrix

  note over Bot: print(matrix[:5]) to console

  Bot -> Solver: update_grid(matrix)
  note over Solver: force marked_cells to val=10 (anti vision miss)
  Bot -> Solver: solve()
  Solver --> Bot: (action, coords, reason)

  alt action == 'NONE'
    Bot -> Bot: state = "RESULT"

  else action == 'CLICK'
    Bot -> Bot: _focus_game_window()
    Bot -> Controller: click_cell(r, c, right_click=False)
    Bot -> Bot: _handle_dialogs()

  else action == 'MARK'
    note over Bot: 1. screenshot + red circle
    Bot -> Vision: get_screenshot()
    Bot -> cv2: circle(pre_img, cell_center)
    Bot -> cv2: imwrite("flag0001.png")
    User -> Bot: review pause (5 sec)
    note over Bot: 2. wait 5 sec for user review
    Bot -> Bot: _focus_game_window()
    Bot -> Controller: click_cell(r, c, right_click=True)
    Bot -> Solver: mark_cell(r, c)
    Bot -> Bot: _handle_dialogs()

    group Post-Mark Cascade [ _cascade_flag_clicks() ]
      loop up to 100 times
        Bot -> Vision: analyze_board(board_info)
        Bot -> Solver: update_grid(matrix)
        Bot -> Solver: solve()
        alt action == 'CLICK'
          Bot -> Controller: click_cell(cell, right_click=False)
        else action == 'MARK'
          Bot -> Controller: click_cell(cell, right_click=True)
          Bot -> Solver: mark_cell(cell)
        else NONE / GUESS
          note over Bot: cascade ends
        end
      end
    end

  else action == 'GUESS'
    Bot -> Bot: _focus_game_window()
    Bot -> Controller: click_cell(r, c, right_click=False)
    Bot -> Bot: _handle_dialogs()
  end

  Bot -> Vision: get_screenshot()
  Bot -> Vision: find_image(screen, game_over_fragment.png / win_fragment.png)
  alt game end detected
    Bot -> Bot: state = "RESULT"
  end
end

== RESULT: Game End Handling ==
Bot -> Bot: _handle_dialogs()
alt dialog handled (Alt+P / Alt+K)
  note over Bot: state already switched
else no dialog found
  Bot -> Vision: get_screenshot()
  Bot -> Vision: find_image(screen, restart_button.png)
  alt restart button found
    Bot -> Controller: click_screen_pos(button_center)
    Bot -> Bot: state = "FIRST_MOVE"
  else not found
    Bot -> Bot: state = "IDLE"
  end
end

@enduml
